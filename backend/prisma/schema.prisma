generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SUPERADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String?  // nullable for google oauth
  phone     String?
  role      Role     @default(CUSTOMER)
  
  googleId  String?
  tokenVersion Int   @default(0)
  status    String   @default("Active")
  
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  addresses Address[]
  orders    Order[]
  wishlist  Product[] @relation("Wishlist")
  reviews   Review[]
  couponUsages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id        String  @id @default(uuid())
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  
  street    String
  city      String
  state     String
  zipCode   String
  country   String  @default("India")
  
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            String   @id @default(uuid())
  name          String
  description   String
  category      String
  
  // FIX #003: stored in paise (integer) to avoid IEEE-754 floating-point drift.
  // Divide by 100 at the API layer for display. Run prisma migrate after this change.
  price         Int                      // paise, e.g. ₹129.99 → 12999
  discount      Int      @default(0)     // basis points: 10% → 1000, 0% → 0
  stock         Int      @default(0)
  
  isFeatured    Boolean  @default(false)
  isActive      Boolean  @default(true)
  
  rating        Float    @default(0)  // product average — kept as Float (not financial)
  numReviews    Int      @default(0)
  
  images        Image[]
  sizes         Size[]
  colors        Color[]

  wishedBy      User[]   @relation("Wishlist")
  orderItems    OrderItem[]
  reviews       Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String
  
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Image {
  id        String  @id @default(uuid())
  url       String
  publicId  String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

model Size {
  id        String  @id @default(uuid())
  name      String // S, M, L, XL, XXL
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

model Color {
  id        String  @id @default(uuid())
  name      String
  hexCode   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

model Order {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  
  items           OrderItem[]
  
  // FIX #003: totalAmount stored in paise (Int) to avoid floating-point drift
  totalAmount     Int
  status          OrderStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  isCOD           Boolean  @default(false)
  
  razorpayOrderId String?
  razorpayPaymentId String?
  razorpaySignature String?

  shippingAddress Json
  trackingNumber  String?

  // FIX #005: track which coupon (if any) was applied to this order
  couponCode      String?
  couponUsage     CouponUsage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  
  product   Product @relation(fields: [productId], references: [id])
  productId String
  
  size      String
  color     String
  quantity  Int
  price     Int // price at time of purchase, stored in paise
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  discountType   DiscountType
  // FIX #003: value stored in paise for FIXED type; basis points (×100) for PERCENTAGE
  // e.g. FIXED ₹50 → 5000 paise | PERCENTAGE 10% → 1000 basis points
  value          Int
  minOrderValue  Int          @default(0)  // paise
  expiryDate     DateTime
  isActive       Boolean      @default(true)

  // FIX #005: usage limits — 0 means unlimited
  maxUsage       Int          @default(0)   // 0 = unlimited total uses
  usageCount     Int          @default(0)   // incremented inside order transaction
  maxUsagePerUser Int         @default(0)   // 0 = unlimited per user

  usages         CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// FIX #005: tracks which user used which coupon on which order
// Used to enforce per-user coupon limits without a race condition.
model CouponUsage {
  id        String   @id @default(uuid())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String   @unique   // one CouponUsage per order

  createdAt DateTime @default(now())

  @@unique([couponId, userId, orderId])
  @@index([couponId, userId])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
